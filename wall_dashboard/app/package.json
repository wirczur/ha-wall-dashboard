{
  "name": "wall-dashboard",
  "version": "0.21.2",
  "private": true,
  "type": "module",
  "description": "Home Assistant add-on: wall tablet dashboards (kiosk + admin editor)",
  "scripts": {
    "dev:server": "node --watch dist/server/index.js",
    "dev:web": "vite",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "build": "npm run build:server && npm run build:web",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "express": "4.21.1",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@mdi/js": "7.4.47",
    "@types/express": "4.17.21",
    "@types/node": "22.7.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@types/three": "^0.169.0",
    "@types/ws": "8.5.12",
    "@vitejs/plugin-react": "4.3.2",
    "hls.js": "^1.5.17",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "^0.169.0",
    "typescript": "5.6.3",
    "vite": "5.4.8"
  }
}
